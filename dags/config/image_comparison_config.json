{
  "_comment": "Image Comparison Pipeline — DAG configuration. The Dataflow job owns window/status management: it reads the earliest PENDING row from the lookup table, marks it RUNNING, runs, then marks DONE or FAILED. The DAG is a pure scheduler — no window fetching or status updates needed here.",

  "project_id": "your-gcp-project",
  "region":     "us-central1",

  "template_gcs_path": "gs://your-bucket/templates/image-comparison",

  "pipeline": {
    "lookup_table":           "your-project:your_dataset.pipeline_config",
    "pipeline_name":          "image_comparison",

    "ai_source_table":        "your-project:ai_dataset.ai_payloads",
    "human_source_table":     "your-project:human_dataset.human_payloads",
    "output_table":           "your-project:dataset.comparison_results",
    "pending_table":          "your-project:dataset.pending_comparisons",
    "dead_letter_table":      "your-project:dataset.dead_letter_comparisons",
    "pending_snapshot_table": "your-project:dataset.pending_snapshot",

    "image_name_field":      "queueImages[0].fileName",
    "firestore_collection":  "dek_store",
    "kms_key_path":          "projects/p/locations/l/keyRings/r/cryptoKeys/k",

    "_comment_filter": "Leave human_filter_field blank to disable payload filtering.",
    "human_filter_field": "",
    "human_filter_value": "",

    "_comment_segments": "Each segment maps a pair of method values to a segment name written into the 'segment' column of every output row. For combined segments (multiple human payloads per image), set payloadFormat='id_request' and list humanSubTypes with a discriminatorField per sub-type.",
    "segments": [
      {
        "_comment": "Standard single-payload segment.",
        "name":        "main",
        "aiMethod":    "aimetadata_v2",
        "humanMethod": "controller.SubmitMain"
      },
      {
        "_comment": "Combined segment: AI sends one payload; human sends two separate id_request payloads (auth + docreview) which are merged before comparison.",
        "name":          "authanddocreview",
        "aiMethod":      "aimetadata",
        "humanMethod":   "controller.SubmitDispute",
        "payloadFormat": "id_request",
        "humanSubTypes": [
          {
            "name":               "auth",
            "discriminatorField": "verifiedData"
          },
          {
            "name":               "docreview",
            "discriminatorField": "docProofs",
            "isBase":             true
          }
        ],
        "fieldMappings": [
          { "humanField": "verifiedData", "aiField": "consumer" }
        ],
        "segmentTypeMappings": [
          { "roots": ["verifiedData", "consumerInformation"], "segmentType": "authentication" }
        ]
      }
    ]
  },

  "dataflow": {
    "service_account":  "pipeline-sa@your-project.iam.gserviceaccount.com",
    "temp_location":    "gs://your-bucket/tmp",
    "staging_location": "gs://your-bucket/staging",
    "max_workers":      20,
    "ip_configuration": "WORKER_IP_PRIVATE"
  }
}
